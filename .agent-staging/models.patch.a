--- a/backend/models.py
+++ b/backend/models.py
@@ -186,6 +186,23 @@
     profile_photo_key = db.Column(db.String(500))
     profile_photo_status = db.Column(db.String(20), nullable=False, default="pending")
 
+    # Public storefront identity. `slug` is the shop's address (/s/<slug>) and
+    # stays NULL until approval assigns one, so a pending shop has no public
+    # link to share. Theme colours are validated #rrggbb in storefront.py.
+    slug = db.Column(db.String(64), unique=True, index=True)
+    tagline = db.Column(db.String(200))
+    theme_primary = db.Column(db.String(7))
+    theme_accent = db.Column(db.String(7))
+    logo_url = db.Column(db.String(500))
+
+    # Stripe Connect (Express). The account id is a Stripe object id, not a
+    # secret. The two flags mirror the account as Stripe last reported it;
+    # checkout only routes money to the shop when charges_enabled is true.
+    stripe_account_id = db.Column(db.String(255), unique=True)
+    stripe_charges_enabled = db.Column(db.Boolean, nullable=False, default=False)
+    stripe_details_submitted = db.Column(db.Boolean, nullable=False, default=False)
+    stripe_connect_updated_at = db.Column(db.DateTime)
+
     inventory_items = db.relationship(
         "SellerInventory",
         back_populates="seller",
@@ -221,6 +238,51 @@
     def identity_verified(self):
         return self.identity_status == "verified"
 
+    @property
+    def connect_status(self):
+        """One word for where this shop is in Connect onboarding.
+
+        "unstarted" (no account), "onboarding" (account exists, Stripe still
+        wants details), "restricted" (details in, charges not enabled yet),
+        "active" (payments route to the shop).
+        """
+        if not self.stripe_account_id:
+            return "unstarted"
+        if self.stripe_charges_enabled:
+            return "active"
+        if self.stripe_details_submitted:
+            return "restricted"
+        return "onboarding"
+
+    @property
+    def accepts_connect_payments(self):
+        return bool(self.stripe_account_id and self.stripe_charges_enabled)
+
+    @property
+    def storefront_path(self):
+        return f"/s/{self.slug}" if self.slug else None
+
+    def theme_dict(self):
+        from storefront import readable_text_on
+
+        return {
+            "primary": self.theme_primary,
+            "accent": self.theme_accent,
+            "on_primary": readable_text_on(self.theme_primary),
+            "on_accent": readable_text_on(self.theme_accent),
+        }
+
+    def connect_dict(self):
+        return {
+            "status": self.connect_status,
+            "account_id": self.stripe_account_id,
+            "charges_enabled": bool(self.stripe_charges_enabled),
+            "details_submitted": bool(self.stripe_details_submitted),
