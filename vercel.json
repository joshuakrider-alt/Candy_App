{
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/about",
      "destination": "/about.html"
    },
    {
      "source": "/faq",
      "destination": "/faq.html"
    },
    {
      "source": "/contact",
      "destination": "/contact.html"
    },
    {
      "source": "/terms",
      "destination": "/terms.html"
    },
    {
      "source": "/pickup",
      "destination": "/pickup.html"
    },
    {
      "source": "/s/:slug",
      "destination": "/shop.html"
    }
  ],
  "redirects": [
    {
      "source": "/web",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/web/:path*",
      "destination": "/",
      "permanent": false
    }
  ]
}
